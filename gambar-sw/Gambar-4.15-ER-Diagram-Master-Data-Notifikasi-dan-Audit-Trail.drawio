        <mxCell id="cat10" value="Tabel users ditampilkan ringkas sebagai entitas acuan; kolom selengkapnya ada pada ER Diagram modul identitas." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="946" width="713" height="20" as="geometry"/></mxCell>
        <mxCell id="cat11" value="Kolom category pada sni_product_master masih berupa teks bebas, belum menjadi kunci asing ke sni_product_categories." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="971" width="752" height="20" as="geometry"/></mxCell>
        <mxCell id="cat12" value="Kode NACE hanya unik di dalam satu kode IAF, karena kode yang sama dapat muncul pada IAF 7a maupun 7b." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="996" width="662" height="20" as="geometry"/></mxCell>
        <mxCell id="cat13" value="Tabel settings menyimpan pengaturan sistem sebagai pasangan key dan value, sehingga memang tidak memiliki relasi ke tabel lain." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1021" width="822" height="20" as="geometry"/></mxCell>
